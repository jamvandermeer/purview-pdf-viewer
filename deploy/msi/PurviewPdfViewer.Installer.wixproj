<Project Sdk="WixToolset.Sdk/7.0.0">
  <!--
    MSI voor Purview PDF Viewer (WiX Toolset v7).
    Bouwen gaat normaal via Build-Msi.ps1; die publiceert en ondertekent eerst de app.
    Handmatig:  dotnet build -c Release -p:Version=1.0.0 -p:AppSourceDir=<publish-map> -p:AcceptEula=wix7
  -->
  <PropertyGroup>
    <OutputName>PurviewPdfViewer</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Version Condition=" '$(Version)' == '' ">1.0.0</Version>
    <AppSourceDir Condition=" '$(AppSourceDir)' == '' ">$(MSBuildThisFileDirectory)staging\app</AppSourceDir>
    <DefineConstants>ProductVersion=$(Version);AppSourceDir=$(AppSourceDir)</DefineConstants>
    <!-- ICE60: .NET-resource-DLL's zonder taalcode; ICE69: verwijzingen tussen componenten binnen
         dezelfde feature. Beide onschuldig voor deze installatie. -->
    <SuppressIces>ICE60;ICE69</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sluit de app af tijdens upgrade/verwijderen -->
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>

  <!-- Bouwmappen niet als bron meenemen -->
  <ItemGroup>
    <Compile Remove="staging\**;out\**;tools\**" />
    <None Remove="staging\**;out\**;tools\**" />
  </ItemGroup>
</Project>
