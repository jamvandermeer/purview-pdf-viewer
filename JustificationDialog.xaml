<Window x:Class="PurviewPdfViewer.JustificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reden voor labelwijziging"
        Icon="/Assets/app.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource TextPrimary}">
    <StackPanel Margin="24">
        <TextBlock Text="Waarom wijzig je dit label?" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                   Text="Je organisatie vereist een reden als je een label verwijdert of vervangt door een minder gevoelig label. De reden wordt vastgelegd in het auditlogboek."/>

        <RadioButton x:Name="ReasonNotApplicable" GroupName="Reason" IsChecked="True" Margin="0,0,0,8"
                     Content="Het vorige label is niet meer van toepassing"/>
        <RadioButton x:Name="ReasonIncorrect" GroupName="Reason" Margin="0,0,0,8"
                     Content="Het vorige label was onjuist toegepast"/>
        <RadioButton x:Name="ReasonOther" GroupName="Reason" Margin="0,0,0,8"
                     Content="Andere reden:"/>
        <TextBox x:Name="OtherText" Margin="22,0,0,0" MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Padding="6,4"
                 IsEnabled="{Binding IsChecked, ElementName=ReasonOther}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Bevestigen" Padding="18,6" IsDefault="True" Click="Confirm_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="Annuleren" Padding="18,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
